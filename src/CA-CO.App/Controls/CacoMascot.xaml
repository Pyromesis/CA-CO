<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CaCo.App.Controls.CacoMascot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d"
    d:DesignHeight="220"
    d:DesignWidth="220">

    <UserControl.Resources>
        <CircleEase x:Key="Soft" EasingMode="EaseInOut" />
        <BackEase x:Key="Pop" EasingMode="EaseOut" />

        <!-- RESPIRACIÓN: escala suave del cuerpo, ida y vuelta, bucle -->
        <Storyboard x:Name="BreatheStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleX"
                From="1"
                To="1.05"
                Duration="0:0:2.4"
                EasingFunction="{StaticResource Soft}" />
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="0.94"
                Duration="0:0:2.4"
                EasingFunction="{StaticResource Soft}" />
        </Storyboard>

        <!-- REBOTE IDLE: flotar 10 px cada 1,2 s -->
        <Storyboard x:Name="IdleBounceStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-10" EasingFunction="{StaticResource Soft}" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- REBOTE FELIZ: amplitud doble -->
        <Storyboard x:Name="HappyBounceStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-24" EasingFunction="{StaticResource Soft}" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- TRABAJANDO: balanceo lateral -->
        <Storyboard x:Name="WobbleStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="RootTransform"
                Storyboard.TargetProperty="Rotation"
                From="-3"
                To="3"
                Duration="0:0:1.1"
                EasingFunction="{StaticResource Soft}" />
        </Storyboard>

        <!-- PARPADEO: cierra los ojos 0,18 s cada 4 s -->
        <Storyboard x:Name="BlinkStoryboard" Duration="0:0:4" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyeScaleL" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.70" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.78" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.86" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.95" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyeScaleR" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.70" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.78" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.86" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.95" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- MEJILLAS (ánimo Happy) -->
        <Storyboard x:Name="CheeksInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CheekL"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="0.85"
                Duration="0:0:0.5" />
            <DoubleAnimation
                Storyboard.TargetName="CheekR"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="0.85"
                Duration="0:0:0.5" />
        </Storyboard>

        <!-- ENTRADA DEL BOCADILLO -->
        <Storyboard x:Name="BubbleInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="BubbleScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.6"
                To="1"
                Duration="0:0:0.28"
                EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation
                Storyboard.TargetName="BubbleScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.6"
                To="1"
                Duration="0:0:0.28"
                EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation
                Storyboard.TargetName="BubbleGrid"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.2" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- BOCADILLO -->
        <Grid
            x:Name="BubbleGrid"
            Margin="0,0,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="0.6" ScaleY="0.6" />
            </Grid.RenderTransform>
            <Path
                Margin="26,34,0,0"
                HorizontalAlignment="Left"
                Data="M0,0 L14,0 L4,18 Z"
                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Stretch="None" />
            <Border
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="14,8">
                <TextBlock
                    x:Name="BubbleText"
                    MaxWidth="220"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="¡Hola!"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- CUERPO -->
        <Viewbox
            Margin="20,4,20,2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <Grid Width="180" Height="180">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="RootTransform" Rotation="0" TranslateX="0" TranslateY="0" />
                </Grid.RenderTransform>

                <Grid x:Name="BodyGrid" RenderTransformOrigin="0.5,0.6">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>

                    <!-- HOJA -->
                    <Path
                        Margin="0,-6,0,0"
                        Data="M90,18 C118,4 142,10 148,34 C120,40 98,32 90,18 Z"
                        Fill="#6FA287"
                        Stretch="None" />
                    <Path
                        Margin="0,-6,0,0"
                        Data="M92,20 C110,18 132,22 144,32"
                        Stretch="None"
                        Stroke="#4E7A61"
                        StrokeThickness="2" />

                    <!-- HABICHUELA -->
                    <Ellipse
                        Width="150"
                        Height="130"
                        VerticalAlignment="Center"
                        Fill="#8B5E34" />
                    <Ellipse
                        Width="118"
                        Height="104"
                        VerticalAlignment="Center"
                        Fill="#C9A063" />
                    <Path
                        VerticalAlignment="Center"
                        Data="M52,52 C74,34 106,34 128,52 C106,46 74,46 52,52 Z"
                        Fill="#6E4A29"
                        Stretch="None" />
                    <Path
                        VerticalAlignment="Center"
                        Data="M58,58 C80,44 100,44 122,58"
                        Stretch="None"
                        Stroke="#5B3C20"
                        StrokeThickness="3" />

                    <!-- MEJILLAS -->
                    <Ellipse
                        x:Name="CheekL"
                        Width="18"
                        Height="12"
                        Margin="0,0,58,0"
                        Fill="#D98A6C"
                        Opacity="0"
                        Stretch="Fill" />
                    <Ellipse
                        x:Name="CheekR"
                        Width="18"
                        Height="12"
                        Margin="58,0,0,0"
                        Fill="#D98A6C"
                        Opacity="0"
                        Stretch="Fill" />

                    <!-- OJOS -->
                    <Grid Margin="0,4,34,0" HorizontalAlignment="Center">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="EyeScaleL" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse Width="22" Height="26" Fill="White" />
                        <Ellipse Width="10" Height="14" Margin="0,2,0,0" Fill="#2E2118" />
                        <Ellipse Width="3.5" Height="3.5" Margin="2,0,0,4" Fill="White" />
                    </Grid>
                    <Grid Margin="34,4,0,0" HorizontalAlignment="Center">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="EyeScaleR" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse Width="22" Height="26" Fill="White" />
                        <Ellipse Width="10" Height="14" Margin="0,2,0,0" Fill="#2E2118" />
                        <Ellipse Width="3.5" Height="3.5" Margin="2,0,0,4" Fill="White" />
                    </Grid>

                    <!-- BOCAS (se alternan por ánimo) -->
                    <Path
                        x:Name="MouthFlat"
                        Margin="0,34,0,0"
                        HorizontalAlignment="Center"
                        Data="M0,0 L20,0"
                        Stretch="None"
                        Stroke="#3E2A18"
                        StrokeThickness="3" />
                    <Path
                        x:Name="MouthSmile"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Data="M0,0 Q10,11 20,0"
                        Stretch="None"
                        Stroke="#3E2A18"
                        StrokeThickness="3"
                        Visibility="Collapsed" />
                    <Path
                        x:Name="MouthFocus"
                        Margin="0,33,0,0"
                        HorizontalAlignment="Center"
                        Data="M2,2 Q10,12 18,2"
                        Stretch="None"
                        Stroke="#3E2A18"
                        StrokeThickness="3"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
