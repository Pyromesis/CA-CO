<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CaCo.App.Controls.MiniBarChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CaCo.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="360">

    <ItemsControl x:Name="ChartHost">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:BarViewModel">
                <Grid Padding="0,2" ColumnSpacing="10" Loaded="BarItem_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Label, Mode=OneTime}" />

                    <!-- Pista -->
                    <Border
                        Grid.Column="1"
                        Height="18"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="9">
                        <!-- Barra: ancho fijo + ScaleX animado (animación independiente, sin layout) -->
                        <Rectangle
                            x:Name="BarFill"
                            Width="220"
                            Height="18"
                            RadiusX="9"
                            RadiusY="9"
                            Fill="{x:Bind Brush, Mode=OneTime}"
                            RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>

                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind Count, Mode=OneTime}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
