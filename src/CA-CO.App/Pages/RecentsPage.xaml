<?xml version="1.0" encoding="utf-8" ?>
<local:RecentsPageBase
    x:Class="CaCo.App.Pages.RecentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:CaCo.Domain"
    xmlns:local="using:CaCo.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:CaCo.App.Views"
    mc:Ignorable="d">

    <Grid
        Padding="32,24,32,32"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="Success" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Recientes" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                Content="Actualizar" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                ContainerContentChanging="List_ContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="List_ItemClick"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="22" />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:Document">
                        <views:DocumentItemView />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border
                Style="{StaticResource CacoEmptyStateBorderStyle}"
                Visibility="{x:Bind ViewModel.IsEmptyList, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE81C;" Style="{StaticResource CacoEmptyStateIconStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                Command="{x:Bind ViewModel.LoadMoreCommand, Mode=OneWay}"
                Content="Cargar más"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</local:RecentsPageBase>
