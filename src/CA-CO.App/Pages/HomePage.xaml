<?xml version="1.0" encoding="utf-8" ?>
<local:HomePageBase
    x:Class="CaCo.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:CaCo.Domain"
    xmlns:local="using:CaCo.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:CaCo.App.Views"
    xmlns:controls="using:CaCo.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Left"
            Spacing="20">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="Success" />

            <Border Style="{StaticResource CacoCardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CacoHeroGradientBrush}"
                        CornerRadius="16">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource CacoHeroBadgeForegroundBrush}"
                            Glyph="&#xE8A5;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CA-CO · OFFLINE-FIRST" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tu biblioteca en orden" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Tu espacio personal para documentos, en este equipo."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ImportButton"
                            Command="{x:Bind ViewModel.ImportCommand, Mode=OneWay}"
                            Content="Importar documento"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="CreateNotebookButton"
                            Command="{x:Bind ViewModel.CreateNotebookCommand, Mode=OneWay}"
                            Content="Crear cuaderno" />
                    </StackPanel>

                    <!-- Mascota: reacciona al estado de la app -->
                    <controls:CacoMascot
                        x:Name="Mascot"
                        Grid.Column="3"
                        Height="180"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Message="¡Hola! Pulsa Ctrl+K para cualquier acción." />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CacoCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Border Background="{ThemeResource CacoTintDocumentsBrush}" Style="{StaticResource CacoStatIconBorderStyle}">
                            <FontIcon Foreground="{ThemeResource CacoTintForegroundBrush}" Glyph="&#xE8A5;" Style="{StaticResource CacoStatIconStyle}" />
                        </Border>
                        <TextBlock x:Name="DocumentCountText" Style="{StaticResource CacoStatNumberTextStyle}" Text="{x:Bind ViewModel.DocumentCount, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Documentos" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CacoCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Border Background="{ThemeResource CacoTintNotebooksBrush}" Style="{StaticResource CacoStatIconBorderStyle}">
                            <FontIcon Foreground="{ThemeResource CacoTintForegroundBrush}" Glyph="&#xE8B7;" Style="{StaticResource CacoStatIconStyle}" />
                        </Border>
                        <TextBlock x:Name="NotebookCountText" Style="{StaticResource CacoStatNumberTextStyle}" Text="{x:Bind ViewModel.NotebookCount, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Cuadernos" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CacoCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Border Background="{ThemeResource CacoTintFavoritesBrush}" Style="{StaticResource CacoStatIconBorderStyle}">
                            <FontIcon Foreground="{ThemeResource CacoTintForegroundBrush}" Glyph="&#xE734;" Style="{StaticResource CacoStatIconStyle}" />
                        </Border>
                        <TextBlock x:Name="FavoriteCountText" Style="{StaticResource CacoStatNumberTextStyle}" Text="{x:Bind ViewModel.FavoriteCount, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Favoritos" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CacoCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Border Background="{ThemeResource CacoTintStorageBrush}" Style="{StaticResource CacoStatIconBorderStyle}">
                            <FontIcon Foreground="{ThemeResource CacoTintForegroundBrush}" Glyph="&#xEBD3;" Style="{StaticResource CacoStatIconStyle}" />
                        </Border>
                        <TextBlock Style="{StaticResource CacoStatNumberTextStyle}" Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Tamaño total" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tu biblioteca de un vistazo -->
            <Border Style="{StaticResource CacoCardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource CacoTintForegroundBrush}"
                            Glyph="&#xE713;" />
                        <TextBlock Style="{StaticResource CacoSectionHeaderTextStyle}" Text="Tu biblioteca de un vistazo" />
                    </StackPanel>
                    <controls:MiniBarChart x:Name="TypeChart" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Recientes" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Tus últimos documentos" />
            </StackPanel>

            <Border
                Style="{StaticResource CacoEmptyStateBorderStyle}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="10">
                    <FontIcon Glyph="&#xE8A5;" Style="{StaticResource CacoEmptyStateIconStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Aún no hay documentos" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Importa tu primer archivo para empezar."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ListView
                ContainerContentChanging="List_ContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="List_ItemClick"
                ItemsSource="{x:Bind ViewModel.RecentDocuments, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="22" />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:Document">
                        <views:RecentDocumentView />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</local:HomePageBase>
